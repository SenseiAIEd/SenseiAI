    {
      "id": "chemistry-basic-hard",
      "subject": "chemistry",
      "band": "basic",
      "level": "hard",
      "slug": "gas_law_kelvin",
      "title": "Gas law kelvin",
      "problem": "CaCO3  ->  CaO + CO2\n25.0 g of CaCO3 decomposes completely.\nFind the volume of CO2 at 25 C and 1.00 atm.\nR = 0.0821 L atm / mol K",
      "answer": "V = 6.12 L",
      "dir": "chemistry/basic/hard",
      "images": {
        "ques": "chemistry/basic/hard/ques.png",
        "good": [
          "chemistry/basic/hard/good_1.png"
        ],
        "bad": [
          "chemistry/basic/hard/bad_1.png"
        ]
      },
      "solutions": [
        {
          "name": "good_1",
          "work": [
            "M(CaCO3) = 40.1 + 12.0 + 3(16.0) = 100.1 g/mol",
            "n(CaCO3) = 25.0 / 100.1 = 0.250 mol",
            "n(CO2) = 0.250 mol      (1 : 1)",
            "T = 25 + 273 = 298 K",
            "V = nRT / P = (0.250)(0.0821)(298) / 1.00",
            "V = 6.12 L"
          ]
        },
        {
          "name": "bad_1",
          "work": [
            "M(CaCO3) = 40.1 + 12.0 + 3(16.0) = 100.1 g/mol",
            "n(CaCO3) = 25.0 / 100.1 = 0.250 mol",
            "n(CO2) = 0.250 mol      (1 : 1)",
            "V = nRT / P = (0.250)(0.0821)(25) / 1.00",
            "V = 0.513 L"
          ]
        }
      ]
    },
    {
      "id": "chemistry-basic-medium",
      "subject": "chemistry",
      "band": "basic",
      "level": "medium",
      "slug": "limiting_reagent",
      "title": "Limiting reagent",
      "problem": "2 H2 + O2  ->  2 H2O\n6.0 g of H2 reacts with 64 g of O2.\nWhat mass of water forms?",
      "answer": "m = 3.0 x 18 = 54 g",
      "dir": "chemistry/basic/medium",
      "images": {
        "ques": "chemistry/basic/medium/ques.png",
        "good": [
          "chemistry/basic/medium/good_1.png"
        ],
        "bad": [
          "chemistry/basic/medium/bad_1.png"
        ]
      },
      "solutions": [
        {
          "name": "good_1",
          "work": [
            "n(H2) = 6.0 / 2.0 = 3.0 mol",
            "n(O2) = 64 / 32 = 2.0 mol",
            "Divide each by its coefficient:",
            "H2: 3.0 / 2 = 1.5    O2: 2.0 / 1 = 2.0",
            "H2 is limiting (smaller ratio)",
            "n(H2O) = n(H2) = 3.0 mol",
            "m = 3.0 x 18 = 54 g"
          ]
        },
        {
          "name": "bad_1",
          "work": [
            "n(H2) = 6.0 / 2.0 = 3.0 mol",
            "n(O2) = 64 / 32 = 2.0 mol",
            "O2 is limiting (fewer moles)",
            "n(H2O) = 2 x 2.0 = 4.0 mol",
            "m = 4.0 x 18 = 72 g"
          ]
        }
      ]
    },
