    {
      "id": "math-advanced-area_between_curves",
      "subject": "math",
      "band": "advanced",
      "level": "area_between_curves",
      "slug": "area_between_curves",
      "title": "Area between curves",
      "problem": "The curves  y = x^2 - 4x + 3  and  y = x - 1\nintersect at two points.\nFind the exact area enclosed between the two curves.",
      "answer": "A = 9/2",
      "dir": "math/advanced/area_between_curves",
      "images": {
        "ques": "math/advanced/area_between_curves/ques.png",
        "good": [
          "math/advanced/area_between_curves/good_1.png"
        ],
        "bad": [
          "math/advanced/area_between_curves/bad_1.png",
          "math/advanced/area_between_curves/bad_2.png",
          "math/advanced/area_between_curves/bad_3.png"
        ]
      },
      "solutions": [
        {
          "name": "good_1",
          "work": [
            "x^2 - 4x + 3 = x - 1",
            "x^2 - 5x + 4 = 0",
            "(x - 1)(x - 4) = 0   ->   x = 1, x = 4",
            "At x = 2:  line = 1, curve = -1, so line is above",
            "A = int_1^4 [(x - 1) - (x^2 - 4x + 3)] dx",
            "A = int_1^4 (-x^2 + 5x - 4) dx",
            "A = [-x^3/3 + 5x^2/2 - 4x] from 1 to 4",
            "A = (8/3) - (-11/6)",
            "A = 9/2"
          ]
        },
        {
          "name": "bad_1",
          "work": [
            "x^2 - 4x + 3 = x - 1",
            "x^2 - 5x + 4 = 0",
            "(x - 1)(x - 4) = 0   ->   x = 1, x = 4",
            "A = int_1^4 [(x^2 - 4x + 3) - (x - 1)] dx",
            "A = int_1^4 (x^2 - 5x + 4) dx",
            "A = [x^3/3 - 5x^2/2 + 4x] from 1 to 4",
            "A = (-8/3) - (11/6)",
            "A = -9/2"
          ]
        },
        {
          "name": "bad_2",
          "work": [
            "x^2 - 4x + 3 = 0",
            "(x - 1)(x - 3) = 0   ->   x = 1, x = 3",
            "A = int_1^3 [(x - 1) - (x^2 - 4x + 3)] dx",
            "A = int_1^3 (-x^2 + 5x - 4) dx",
            "A = [-x^3/3 + 5x^2/2 - 4x] from 1 to 3",
            "A = (3/2) - (-11/6)",
            "A = 10/3"
          ]
        },
        {
          "name": "bad_3",
          "work": [
            "x^2 - 4x + 3 = x - 1",
            "x^2 - 5x + 4 = 0",
            "(x - 1)(x - 4) = 0   ->   x = 1, x = 4",
            "A = int_1^4 [(x - 1) - (x^2 - 4x + 3)] dx",
            "A = int_1^4 (-x^2 + 5x - 4) dx",
            "A = [-x^3/3 + 5x^2/2 - 4x] from 1 to 4",
            "A = (8/3) - (11/6)",
            "A = 5/6"
          ]
        }
      ]
    },
    {
      "id": "math-advanced-cone",
      "subject": "math",
      "band": "advanced",
      "level": "cone",
      "slug": "cone",
      "title": "Cone",
      "problem": "A right circular cone has radius 6 cm\nand slant height 10 cm.\nDraw a labelled diagram, then find:\n(i) the vertical height,  (ii) the total surface area,\n(iii) the volume.",
      "answer": "V = 96 pi cm^3",
      "dir": "math/advanced/cone",
      "images": {
        "ques": "math/advanced/cone/ques.png",
        "good": [
          "math/advanced/cone/good_1.png"
        ],
        "bad": [
          "math/advanced/cone/bad_1.png",
          "math/advanced/cone/bad_2.png",
          "math/advanced/cone/bad_3.png",
          "math/advanced/cone/bad_4.png",
          "math/advanced/cone/bad_5.png"
        ]
      },
      "solutions": [
        {
          "name": "good_1",
          "work": [
            "In right triangle POA:",
            "PA^2 = PO^2 + OA^2",
            "10^2 = h^2 + 6^2",
            "h^2 = 100 - 36 = 64,   h = 8 cm",
            "Curved area = pi r l = pi(6)(10) = 60 pi",
            "Base area = pi r^2 = pi(6)^2 = 36 pi",
            "Total = 60 pi + 36 pi = 96 pi cm^2",
            "V = (1/3) pi r^2 h = (1/3) pi (36)(8)",
            "V = 96 pi cm^3"
          ]
        },
        {
          "name": "bad_1",
          "work": [
            "10^2 = h^2 + 6^2",
            "h^2 = 100 - 36 = 64,   h = 8 cm",
            "Total surface area = pi r l",
            "= pi(6)(10) = 60 pi cm^2",
            "V = (1/3) pi r^2 h = (1/3) pi (36)(8)",
            "V = 96 pi cm^3"
          ]
        },
        {
          "name": "bad_2",
          "work": [
            "10^2 = h^2 + 6^2",
            "h^2 = 100 - 36 = 64,   h = 8 cm",
            "Curved area = pi r l = pi(6)(10) = 60 pi",
            "Base area = pi r^2 = 36 pi",
            "Total = 96 pi cm^2",
            "V = (1/3) pi r^2 l = (1/3) pi (36)(10)",
            "V = 120 pi cm^3"
          ]
        },
        {
          "name": "bad_3",
          "work": [
            "h^2 = 10^2 + 6^2 = 136",
            "h = 11.66 cm",
            "Curved area = pi r l = pi(6)(10) = 60 pi",
            "Base area = pi r^2 = 36 pi",
            "Total = 96 pi cm^2",
            "V = (1/3) pi (36)(11.66)",
            "V = 139.9 pi cm^3"
          ]
        }
      ]
    },
    {
      "id": "math-advanced-optimization",
      "subject": "math",
      "band": "advanced",
      "level": "optimization",
      "slug": "optimization",
      "title": "Optimization",
      "problem": "A rectangular sheet of cardboard measures 30 cm x 20 cm.\nSquares of side x are cut from each corner and the sides\nare folded up to form an open box.\nFind the value of x that maximizes the volume.",
      "answer": "x = 3.92 cm",
      "dir": "math/advanced/optimization",
      "images": {
        "ques": "math/advanced/optimization/ques.png",
        "good": [
          "math/advanced/optimization/good_1.png"
        ],
        "bad": [
          "math/advanced/optimization/bad_1.png",
          "math/advanced/optimization/bad_2.png",
          "math/advanced/optimization/bad_3.png"
        ]
      },
      "solutions": [
        {
          "name": "good_1",
          "work": [
            "V = x(30 - 2x)(20 - 2x)",
            "V = 4x^3 - 100x^2 + 600x",
            "dV/dx = 12x^2 - 200x + 600 = 0",
            "3x^2 - 50x + 150 = 0",
            "x = [50 +- sqrt(2500 - 1800)] / 6",
            "x = (50 +- sqrt700) / 6  ->  x = 3.92 or x = 12.74",
            "Need 0 < x < 10, so reject x = 12.74",
            "d2V/dx2 = 24(3.92) - 200 = -105.9 < 0, so maximum",
            "x = 3.92 cm"
          ]
        },
        {
          "name": "bad_1",
          "work": [
            "V = x(30 - x)(20 - x)",
            "V = x^3 - 50x^2 + 600x",
            "dV/dx = 3x^2 - 100x + 600 = 0",
            "x = [100 +- sqrt(10000 - 7200)] / 6",
            "x = (100 +- sqrt2800) / 6  ->  x = 7.85 or x = 25.49",
            "x = 7.85 cm"
          ]
        },
        {
          "name": "bad_2",
          "work": [
            "V = x(30 - 2x)(20 - 2x)",
            "V = 4x^3 - 100x^2 + 600x",
            "dV/dx = 12x^2 - 200x + 600 = 0",
            "3x^2 - 50x + 150 = 0",
            "x = (50 +- sqrt700) / 6",
            "x = 3.92 or x = 12.74",
            "A bigger cut gives a bigger box, so x = 12.74 cm"
          ]
        },
        {
          "name": "bad_3",
          "work": [
            "V = x(30 - 2x)(20 - 2x)",
            "(30 - 2x)(20 - 2x) = 600 - 60x - 40x = 600 - 100x",
            "V = 600x - 100x^2",
            "dV/dx = 600 - 200x = 0",
            "x = 3 cm"
          ]
        }
      ]
    },
    {
      "id": "math-advanced-trig_equation",
      "subject": "math",
      "band": "advanced",
      "level": "trig_equation",
      "slug": "trig_equation",
      "title": "Trig equation",
      "problem": "Solve for all x in 0 <= x <= 360 degrees:\n2 sin^2 x - 3 sin x cos x - cos^2 x = 0",
      "answer": "x = 60.68, 164.32, 240.68, 344.32 degrees",
      "dir": "math/advanced/trig_equation",
      "images": {
        "ques": "math/advanced/trig_equation/ques.png",
        "good": [
          "math/advanced/trig_equation/good_1.png"
        ],
        "bad": [
          "math/advanced/trig_equation/bad_1.png",
          "math/advanced/trig_equation/bad_2.png",
          "math/advanced/trig_equation/bad_3.png"
        ]
      },
      "solutions": [
        {
          "name": "good_1",
          "work": [
            "If cos x = 0 then 2(1) - 0 - 0 = 2, not 0. So cos x =/= 0.",
            "Divide by cos^2 x:",
            "2 tan^2 x - 3 tan x - 1 = 0",
            "tan x = [3 +- sqrt(9 + 8)] / 4",
            "tan x = 1.7808   or   tan x = -0.2808",
            "tan x = 1.7808  ->  x = 60.68, 240.68",
            "tan x = -0.2808  ->  x = 164.32, 344.32",
            "x = 60.68, 164.32, 240.68, 344.32 degrees"
          ]
        },
        {
          "name": "bad_1",
          "work": [
            "Divide by cos^2 x:",
            "2 tan^2 x - 3 tan x - 1 = 0",
            "tan x = [3 +- sqrt(9 + 8)] / 4",
            "tan x = 1.7808   or   tan x = -0.2808",
            "arctan(1.7808) = 60.68",
            "arctan(-0.2808) = -15.68, so x = 180 - 15.68 = 164.32",
            "x = 60.68 and 164.32 degrees"
          ]
        },
        {
          "name": "bad_2",
          "work": [
            "Divide by cos^2 x:",
            "2 tan^2 x - 3 tan x - 1 = 0",
            "tan x = [3 +- sqrt(9 - 8)] / 4",
            "tan x = (3 + 1)/4 = 1   or   (3 - 1)/4 = 0.5",
            "tan x = 1  ->  x = 45, 225",
            "tan x = 0.5  ->  x = 26.57, 206.57",
            "x = 26.57, 45, 206.57, 225 degrees"
          ]
        },
        {
          "name": "bad_3",
          "work": [
